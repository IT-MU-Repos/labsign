# .NET 8 SDK + SoftHSM2, for running the suite (including the PKCS#11 token tests) on Linux.
# No libdl symlink on purpose: the app resolves "libdl" itself (NativeLibraryFix), and the
# tests must catch it if that ever stops working on a current glibc.
FROM mcr.microsoft.com/dotnet/sdk:8.0
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends softhsm2 && rm -rf /var/lib/apt/lists/*
